---
import { Image } from 'astro:assets';
import { especialidades } from '../data/especialidades';
---

<section class="seccion especialidades" id="especialidades" aria-labelledby="titulo-especialidades">
  <div class="contenedor">
    <header class="especialidades__cabeza" data-revelar>
      <h2 id="titulo-especialidades">Especialidades</h2>
      <span class="filete" aria-hidden="true"></span>
      <p>Los asuntos que más atendemos en Puerto Maldonado y el resto de Madre de Dios.</p>
    </header>

    <ol class="especialidades__lista" role="list">
      {especialidades.map((e) => (
        <li class="especialidad" id={e.id} data-revelar>
          <div class="especialidad__foto foto-zoom">
            <Image src={e.imagen} alt={e.alt} widths={[240, 480]} sizes="(max-width: 560px) 100vw, 240px" />
          </div>
          <div class="especialidad__texto">
            <h3>{e.nombre}</h3>
            <ul>
              {e.casos.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .especialidades {
    background: var(--blanco);
  }

  .especialidades__cabeza {
    max-width: 38rem;
  }

  .especialidades__cabeza p {
    margin-top: 1.25rem;
    font-size: 1.125rem;
    color: var(--tinta-suave);
  }

  .especialidades__lista {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3rem) clamp(2rem, 5vw, 4rem);
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  /* La quinta especialidad queda sola: se centra en la última fila */
  .especialidad:last-child:nth-child(odd) {
    grid-column: 1 / -1;
    justify-self: center;
    width: calc(50% - clamp(1rem, 2.5vw, 2rem));
  }

  /* Foto y texto lado a lado; la foto toma el alto del texto */
  .especialidad {
    display: grid;
    grid-template-columns: 11.5rem minmax(0, 1fr);
    gap: 1.5rem;
    align-items: stretch;
  }

  .especialidad__foto {
    min-height: 11.5rem;
    border-radius: var(--radio);
  }

  .especialidad__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .especialidad__texto {
    align-self: center;
  }

  .especialidad h3 {
    font-size: clamp(1.3rem, 1.1rem + 0.6vw, 1.6rem);
    color: var(--selva-900);
  }

  .especialidad ul {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .especialidad ul li {
    position: relative;
    padding: 0.25rem 0 0.25rem 1.4rem;
    font-size: 1rem;
    line-height: 1.5;
  }

  /* Rombo dorado como viñeta */
  .especialidad ul li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.9em;
    width: 6px;
    height: 6px;
    background: var(--oro-500);
    transform: rotate(45deg);
  }

  @media (max-width: 1000px) {
    .especialidades__lista {
      grid-template-columns: 1fr;
    }

    .especialidad:last-child:nth-child(odd) {
      width: 100%;
    }
  }

  @media (max-width: 560px) {
    .especialidad {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .especialidad__foto {
      min-height: 0;
      aspect-ratio: 5 / 4;
    }
  }
</style>
