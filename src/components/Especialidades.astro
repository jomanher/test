---
import { Image } from 'astro:assets';
import { especialidades } from '../data/especialidades';
---

<section class="seccion especialidades" id="especialidades" aria-labelledby="titulo-especialidades">
  <div class="contenedor">
    <header class="especialidades__cabeza" data-revelar>
      <h2 id="titulo-especialidades">Especialidades</h2>
      <span class="filete" aria-hidden="true"></span>
      <p>Los asuntos que más atendemos en Puerto Maldonado y el resto de Madre de Dios.</p>
    </header>

    <ol class="especialidades__lista" role="list">
      {especialidades.map((e, i) => (
        <li class="especialidad" id={e.id} data-revelar style={`--columna: ${i % 2}`}>
          <div class="especialidad__foto foto-zoom">
            <Image src={e.imagen} alt={e.alt} widths={[240, 480]} sizes="(max-width: 560px) 100vw, 240px" />
          </div>
          <div class="especialidad__texto">
            <h3>{e.nombre}</h3>
            <ul>
              {e.casos.map((c, j) => (
                <li style={`--orden: ${j}`}>{c}</li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .especialidades {
    background: var(--blanco);
  }

  .especialidades__cabeza {
    max-width: 38rem;
  }

  .especialidades__cabeza p {
    margin-top: 1.25rem;
    font-size: 1.125rem;
    color: var(--tinta-suave);
  }

  .especialidades__lista {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3rem) clamp(2rem, 5vw, 4rem);
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  /* La quinta especialidad queda sola: se centra en la última fila */
  .especialidad:last-child:nth-child(odd) {
    grid-column: 1 / -1;
    justify-self: center;
    width: calc(50% - clamp(1rem, 2.5vw, 2rem));
  }

  /* Foto y texto lado a lado; la foto toma el alto del texto */
  .especialidad {
    display: grid;
    grid-template-columns: 11.5rem minmax(0, 1fr);
    gap: 1.5rem;
    align-items: stretch;
  }

  .especialidad__foto {
    min-height: 11.5rem;
    border-radius: var(--radio);
  }

  .especialidad__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .especialidad__texto {
    align-self: center;
  }

  .especialidad h3 {
    font-size: clamp(1.3rem, 1.1rem + 0.6vw, 1.6rem);
    color: var(--selva-900);
  }

  .especialidad ul {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .especialidad ul li {
    position: relative;
    padding: 0.25rem 0 0.25rem 1.4rem;
    font-size: 1rem;
    line-height: 1.5;
  }

  /* Rombo dorado como viñeta */
  .especialidad ul li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.9em;
    width: 6px;
    height: 6px;
    background: var(--oro-500);
    transform: rotate(45deg);
  }

  /*
   * Entrada al hacer scroll: la foto se descubre de izquierda a derecha y el
   * texto llega después, punto por punto. La columna derecha va un poco detrás.
   */
  .especialidad {
    --retraso: calc(var(--columna, 0) * 140ms);
  }

  :global(.js) .especialidad[data-revelar] {
    opacity: 1;
    transform: none;
  }

  :global(.js) .especialidad__foto {
    clip-path: inset(0 100% 0 0 round var(--radio));
    transition: clip-path 1000ms var(--ease) var(--retraso);
  }

  :global(.js) .especialidad__foto :global(img) {
    scale: 1.12;
    transition:
      scale 1400ms var(--ease) var(--retraso),
      transform 900ms var(--ease);
  }

  :global(.js) .especialidad h3,
  :global(.js) .especialidad ul li {
    opacity: 0;
    transform: translateX(18px);
    transition:
      opacity 700ms var(--ease),
      transform 700ms var(--ease);
  }

  :global(.js) .especialidad h3 {
    transition-delay: calc(var(--retraso) + 300ms);
  }

  :global(.js) .especialidad ul li {
    transition-delay: calc(var(--retraso) + 420ms + var(--orden, 0) * 80ms);
  }

  :global(.js) .especialidad:global(.visible) .especialidad__foto {
    clip-path: inset(0 0 0 0 round var(--radio));
  }

  :global(.js) .especialidad:global(.visible) .especialidad__foto :global(img) {
    scale: 1;
  }

  :global(.js) .especialidad:global(.visible) h3,
  :global(.js) .especialidad:global(.visible) ul li {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .especialidad__foto {
      clip-path: none;
    }

    :global(.js) .especialidad__foto :global(img) {
      scale: 1;
    }

    :global(.js) .especialidad h3,
    :global(.js) .especialidad ul li {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 1000px) {
    /* En una sola columna no hace falta desfasar */
    .especialidad {
      --retraso: 0ms;
    }

    .especialidades__lista {
      grid-template-columns: 1fr;
    }

    .especialidad:last-child:nth-child(odd) {
      width: 100%;
    }
  }

  @media (max-width: 560px) {
    .especialidad {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .especialidad__foto {
      min-height: 0;
      aspect-ratio: 5 / 4;
    }
  }
</style>
