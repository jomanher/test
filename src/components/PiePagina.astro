---
import { Image } from 'astro:assets';
import logoPie from '../assets/logo_pie.png';
import { sitio, whatsappUrl } from '../data/sitio';
---

<footer class="pie">
  <div class="contenedor pie__rejilla">
    <Image class="pie__logo" src={logoPie} alt="Estudio Manrique" height={64} densities={[1, 2]} />
    <address class="pie__datos">
      <span>{sitio.direccion}, {sitio.ciudad}, {sitio.region}</span>
      <a href={whatsappUrl} target="_blank" rel="noopener">WhatsApp {sitio.whatsappVisible}</a>
    </address>
  </div>
  <div class="contenedor pie__legal">
    <p>© {sitio.anioCopyright} {sitio.nombre}. Todos los derechos reservados.</p>
  </div>
</footer>

<style>
  .pie {
    background: var(--selva-950);
    color: rgb(255 255 255 / 0.8);
    font-size: 0.95rem;
  }

  .pie__rejilla {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 3.5rem 2.5rem;
  }

  .pie :global(.pie__logo) {
    width: auto;
    height: 64px;
  }

  .pie__datos {
    display: grid;
    gap: 0.4rem;
    font-style: normal;
    text-align: right;
  }

  .pie__datos a {
    color: var(--oro-300);
    text-decoration: none;
  }

  .pie__datos a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .pie__legal {
    padding-block: 1.25rem 1.5rem;
    border-top: 1px solid rgb(231 191 136 / 0.2);
    font-size: 0.875rem;
    color: rgb(255 255 255 / 0.6);
  }

  @media (max-width: 760px) {
    .pie__rejilla {
      flex-direction: column;
      align-items: flex-start;
    }

    .pie :global(.pie__logo) {
      height: 52px;
    }

    .pie__datos {
      text-align: left;
    }

    /* Espacio para que el botón flotante de WhatsApp no tape el texto legal */
    .pie__legal {
      padding-bottom: 6rem;
    }
  }
</style>
